# ==============================================================================
# Page Watcher Environment Variables Template
# Copy this file to .env for local testing or configure in GitHub Repo Secrets
# ==============================================================================

# Target URLs to watch (comma-separated list)
WATCH_URLS=https://example.com/events/summer-rsvp,https://example.com/products/item

# ------------------------------------------------------------------------------
# Resend Email Configuration (Required for Email Alerts)
# Sign up and get your API key at https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_123456789_abcdefg
# The email address that should receive alerts
ALERT_EMAIL_TO=user@example.com
# The sender email address. If using Resend default test domain, use: "onboarding@resend.dev"
# If you have verified your custom domain in Resend, use e.g. "alerts@yourdomain.com"
ALERT_EMAIL_FROM=onboarding@resend.dev

# ------------------------------------------------------------------------------
# TextBelt SMS Configuration (Required for SMS Alerts)
# Sign up and get your quota key at https://textbelt.com
# Note: "textbelt" can be used as a free key for 1 SMS/day for testing
# ------------------------------------------------------------------------------
TEXTBELT_API_KEY=your_textbelt_api_key_here
# Target phone number for SMS alerts (Include country code, e.g. +1234567890)
ALERT_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# Automation Form Details (Injected into registration macros)
# ------------------------------------------------------------------------------
REGISTRATION_NAME=Jane Doe
REGISTRATION_EMAIL=jane.doe@example.com
REGISTRATION_PHONE=5551234567

# ------------------------------------------------------------------------------
# Optional Watcher Settings
# ------------------------------------------------------------------------------
# Set to 'true' to run Playwright with a visible browser window (for local debug only)
HEADLESS=true
# Set to 'true' to capture and save diagnostic screenshots on errors.
# Keep 'false' on public repositories to prevent capturing rendered personal inputs.
ENABLE_SCREENSHOTS=false
# Navigation / wait timeout in milliseconds (default: 30000ms / 30s)
TIMEOUT_MS=30000
